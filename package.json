{
  "name": "stock-management-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/line-limit.mjs",
    "lint:legacy": "node scripts/legacy-check.mjs",
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:int": "dotenv -e .env.test -- vitest run --project integration",
    "test:e2e": "dotenv -v NODE_OPTIONS=--conditions=react-server -- playwright test --project=chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server src/lib/db/scripts/setup-initial-data.ts",
    "db:seed-users": "tsx --conditions=react-server src/lib/db/scripts/seed-users.ts",
    "db:reset-data": "tsx --conditions=react-server src/lib/db/scripts/setup-initial-data.ts",
    "db:reset-full": "tsx src/lib/db/scripts/reset-full.ts",
    "db:stress-test": "tsx --conditions=react-server src/lib/db/scripts/seed-stress-test.ts",
    "db:backfill-cost": "tsx --conditions=react-server src/lib/db/scripts/backfill-sale-item-cost.ts",
    "db:enable-unaccent": "tsx --conditions=react-server src/scripts/enable-unaccent.ts",
    "skills:sync": "node scripts/skills.mjs sync",
    "skills:check": "node scripts/skills.mjs check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.100.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.0.1",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-virtuoso": "^4.18.4",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
