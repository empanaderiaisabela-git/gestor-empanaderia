# Copiá este archivo a .env.local (desarrollo) y completá los valores. Nunca commitees un .env real.

# Qué base se usa: vacío, development o test → .env.local y LOCAL_DATABASE_URL.
# production → .env.prod y DATABASE_URL, con SSL. NODE_ENV no elige la base (ADR 0002).
APP_ENV=

# Base de desarrollo: servicio "db" de docker-compose.yml (puerto 5433 en el host).
LOCAL_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/stock_db

# Obligatoria: sin ella no se firman ni se verifican sesiones. Usá un valor largo y aleatorio.
JWT_SECRET=

# Fotos de producto. Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Sólo en .env.prod: base de producción (Supabase, pooler con SSL).
DATABASE_URL=
